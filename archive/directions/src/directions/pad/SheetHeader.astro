---
// The strip printed across the top of every sheet of the pad. Real fields only.
import logoDark from "../../assets/logo-dark.svg";
import logoLight from "../../assets/logo-light.svg";
import { sheetCount, titleBlock } from "./content";

interface Props {
  sheet: number;
  subject: string;
  // Sheet 1 writes the project as its mark.
  withLogo?: boolean;
}

const { sheet, subject, withLogo = false } = Astro.props;
---

<header>
  <dl class="strip strip--head">
    <div class="field field--project field--full">
      <dt>Project</dt>
      <dd>
        {
          withLogo ? (
            <picture>
              <source media="(prefers-color-scheme: dark)" srcset={logoDark.src} />
              <img alt={titleBlock.project} height={logoLight.height} src={logoLight.src} width={logoLight.width} />
            </picture>
          ) : (
            titleBlock.project
          )
        }
      </dd>
    </div>
    <div class="field"><dt>Subject</dt><dd>{subject}</dd></div>
    <div class="field"><dt>Sheet</dt><dd>{sheet} of {sheetCount}</dd></div>
  </dl>
</header>
