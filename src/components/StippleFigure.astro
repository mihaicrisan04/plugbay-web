---
// A stipple illustration, drawn in Paper and shipped as a one-bit mask so it
// prints in the sheet's ink. The `marks` slot places things on the artwork.
import "./stipple-figure.css";
import type { ImageMetadata } from "astro";
import { maskStyle } from "../lib/art";

interface Props {
  art: ImageMetadata;
  class?: string;
  label: string;
  // The artwork's file name without its extension: `name-dark.png`, where it
  // exists, is the mask for the dark theme.
  name: string;
}

const { art, label, name, class: className } = Astro.props;
---

<figure class:list={["stipple-figure", className]}>
  <div
    aria-label={label}
    class="stipple-art"
    role="img"
    style={`${maskStyle(art, name)};aspect-ratio:${art.width} / ${art.height}`}
  >
    <span class="stipple"></span>
    <slot name="marks" />
  </div>
</figure>
