---
// Zone C. Three small files, then the drawing of how far each line of them
// reaches, for the directory chosen on its tab.
import "./one-file-per-tree.css";
import { callouts } from "../data/plugbay";
import { zoneTitles } from "../lib/content";
import { files } from "../lib/model";
import Elevation from "./Elevation.astro";
import FilePanel from "./FilePanel.astro";
import ZoneRef from "./ZoneRef.astro";
---

<section class="zone" id="c">
  <ZoneRef letter="C" />
  <header class="zone-head">
    <h2 class="section-title">{zoneTitles.oneFilePerTree}</h2>
    <p class="prose">{callouts.deeperWins}</p>
  </header>
  <div class="files">
    {files.map((file) => <FilePanel file={file} />)}
  </div>
  <Elevation />
</section>
