---
// Zone D. The three steps as a ruled list, the install commands, and the
// plain facts on one line.
import "./install.css";
import { facts, install, steps } from "../data/plugbay";
import { zoneTitles } from "../lib/content";
import CopyCommand from "./CopyCommand.astro";
import ZoneRef from "./ZoneRef.astro";

const numberOf = (index: number) => String(index + 1).padStart(2, "0");
---

<section class="zone install" id="d">
  <ZoneRef letter="D" />
  <h2 class="section-title">{zoneTitles.install}</h2>
  <ol class="steps">
    {steps.map((step, index) => (
      <li class="step">
        <span aria-hidden="true" class="label step-number">{numberOf(index)}</span>
        <h3 class="step-title">{step.title}</h3>
        <code class="step-command"><span aria-hidden="true" class="command-prompt">$ </span>{step.command}</code>
      </li>
    ))}
  </ol>
  <div class="install-commands">
    <CopyCommand class="command-primary" command={install.brew} />
    <CopyCommand command={install.cargo} />
  </div>
  <ul class="facts">
    {facts.map((fact) => <li>{fact}</li>)}
  </ul>
</section>
