---
// Zone D. The directory the agent starts in, and what plugbay really prints
// there. This is the page's one radio group; the elevation in zone C reads it.
import "./detail.css";
import { zoneTitles } from "../lib/content";
import { details, lsColumns, whyColumns } from "../lib/model";
import Capture from "./Capture.astro";
import ZoneRef from "./ZoneRef.astro";

// The line of `plugbay why` that answers "why": which file set the account.
// On a phone that column is off screen, so the page repeats it under the
// capture, read from the same output.
const ACCOUNT_ROW = /^\s*account\s+(?<account>\S+)\s+(?<file>\S+)$/m;

function setByOf(output: string) {
  const row = ACCOUNT_ROW.exec(output)?.groups;
  if (!row) {
    throw new Error("`plugbay why` no longer prints an account row");
  }
  return row;
}
---

<section class="zone detail" id="d" style={`--ls-cols:${lsColumns};--why-cols:${whyColumns}`}>
  <ZoneRef letter="D" />
  <h2 class="section-title detail-title">{zoneTitles.detail}</h2>

  <fieldset class="chooser">
    <legend class="label">Agent starts in</legend>
    <div class="choices">
      {details.map((detail) => (
        <label class="choice">
          <input
            checked={detail === details[0]}
            class="sr-only"
            id={`detail-${detail.id}`}
            name="detail"
            type="radio"
            value={detail.id}
          />
          <span aria-hidden="true" class="balloon">{detail.letter}</span>
          {detail.directory}
        </label>
      ))}
    </div>
  </fieldset>

  <div class="detail-views">
    {details.map((detail) => (
      <div class={`detail-view is-${detail.id}`}>
        <Capture session={detail.ls} />
        <Capture session={detail.why} />
        <p class="set-by">
          <span class="label">Set by</span>
          account {setByOf(detail.why.output).account}: {setByOf(detail.why.output).file}
        </p>
      </div>
    ))}
  </div>
</section>
