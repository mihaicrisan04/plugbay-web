---
// One plugbay.toml at 1:1, with the folded corner of the file mark.
import "./file-panel.css";
import type { ConfigFile } from "../lib/model";

interface Props {
  file: ConfigFile;
}

const { file } = Astro.props;
---

<figure class="window file-panel">
  <figcaption class="window-bar">{file.path}</figcaption>
  <div class="file-source">
    {file.lines.map((line) => <code class="file-line">{line}</code>)}
  </div>
</figure>
