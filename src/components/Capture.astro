---
// A terminal capture as an instrument window, shown at 1:1. The corner squares
// mark it as cut from a real session. plugbay prints no colour, so the output
// stays one colour; only the prompt is styled. The output is never abridged:
// where the window is narrower than it, the output scrolls sideways.
import "./capture.css";
import { columnsOf, type Session } from "../lib/model";

interface Props {
  class?: string;
  session: Session;
}

const { session, class: className } = Astro.props;
const name = `${session.command} in ${session.cwd}`;
---

<figure aria-label={`Terminal: ${name}`} style={`--cols:${columnsOf([session])}`} class:list={["window capture", className]} >
  <figcaption class="window-bar">
    <span class="bar-subject">{session.command}</span>
    <span class="bar-end capture-meta">
      <span aria-hidden="true" class="label capture-hint">
        Scroll
        <svg aria-hidden="true" fill="none" height="8" viewBox="0 0 14 8" width="14">
          <path d="M0 4h13M9.5.5 13 4 9.5 7.5" stroke="currentColor" />
        </svg>
      </span>
      <span class="label">Scale 1:1</span>
    </span>
  </figcaption>
  <div class="capture-body">
    <span aria-hidden="true" class="corner-squares"></span>
    <section aria-label={`Output of ${name}`} class="capture-scroll" tabindex="0">
      <pre><code><span class="prompt">{session.cwd} $</span>{` ${session.command}\n`}{session.output}</code></pre>
    </section>
  </div>
</figure>
