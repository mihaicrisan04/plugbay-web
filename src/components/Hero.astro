---
// Zone A. The statement, what it is in one line, the install command and one
// drawing: plugbay's own
// metaphor, a patch bay being patched by hand. No grid: each server is named
// over its column of sockets, each directory lettered on its row.
import "./hero.css";
import art from "../assets/patch-bay.png";
import { hero, install, links } from "../data/plugbay";
import { details, servers } from "../lib/model";
import CopyCommand from "./CopyCommand.astro";
import Masthead from "./Masthead.astro";
import StippleFigure from "./StippleFigure.astro";
import ZoneRef from "./ZoneRef.astro";

// The statement is set on three lines. The words are the data's, unchanged.
const WORDS_PER_LINE = [2, 2];
const words = hero.statement.split(" ");
const [first, second] = WORDS_PER_LINE;
const lines = [
  words.slice(0, first),
  words.slice(first, first + second),
  words.slice(first + second),
].map((line) => line.join(" "));

// The one-line what names the file, and a literal stays in mono.
const FILE_NAME = "plugbay.toml";
const [beforeFile, afterFile, ...rest] = hero.what.split(FILE_NAME);
if (afterFile === undefined || rest.length > 0) {
  throw new Error(`The one-line what no longer names ${FILE_NAME} once`);
}

// Where the artwork's socket centres sit, as a percentage of its box: one
// column per server, one row per directory.
const columns = [14.94, 32.73, 50.17];
const rows = [17.64, 41.46];

if (columns.length !== servers.length || rows.length !== details.length) {
  throw new Error(
    `The patch bay is drawn ${columns.length} by ${rows.length}, the data has ${servers.length} servers and ${details.length} directories`
  );
}
---

<section class="zone hero" id="a">
  <ZoneRef letter="A" />

  <Masthead />

  <div class="statement">
    <h1 class="headline">
      {lines.map((line) => <span>{line} </span>)}
    </h1>
    <p class="prose subhead">{beforeFile}<code>{FILE_NAME}</code>{afterFile}</p>
    <div class="actions">
      <CopyCommand command={install.brew} />
      <a class="label box-link" href={links.repo}>
        GitHub
        <svg aria-hidden="true" fill="none" height="10" viewBox="0 0 10 10" width="10">
          <path d="M2.5 1.5h6v6M8.5 1.5l-7 7" stroke="currentColor" />
        </svg>
      </a>
    </div>
  </div>

  <StippleFigure
    art={art}
    class="pictorial"
    label={`A hand patching a cable into a patch bay. Its columns are ${servers.join(", ")}; its rows are ${details.map((detail) => detail.directory).join(" and ")}.`}
    name="patch-bay"
  >
    <div aria-hidden="true" class="contents" slot="marks">
      {servers.map((server, index) => (
        <span class="bay-name" style={`left:${columns[index]}%`}>{server}</span>
      ))}
      {details.map((detail, index) => (
        <span class="balloon bay-mark" style={`top:${rows[index]}%`}>{detail.letter}</span>
      ))}
      <span class="bay-key">
        {details.map((detail) => (
          <span><span class="balloon">{detail.letter}</span>{detail.directory}</span>
        ))}
      </span>
    </div>
  </StippleFigure>
</section>
