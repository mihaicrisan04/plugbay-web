---
// Zone E. Three steps, each with its command and one figure.
import "./how-it-works.css";
import keyRing from "../assets/key-ring.png";
import sockets from "../assets/sockets.png";
import { callouts, steps } from "../data/plugbay";
import { agents, zoneTitles } from "../lib/content";
import { accounts } from "../lib/model";
import CopyCommand from "./CopyCommand.astro";
import Stack from "./figures/Stack.astro";
import StippleFigure, { type ArtNote, type ArtPlace } from "./StippleFigure.astro";
import ZoneRef from "./ZoneRef.astro";

const [setup, use, login] = steps;

// Pairs each place in an artwork with the real thing it is, and refuses to
// build if the drawing and the data disagree on how many there are.
function named(places: ArtPlace[], texts: string[], what: string): ArtNote[] {
  if (places.length !== texts.length) {
    throw new Error(`The ${what} drawing has ${places.length} places, the data has ${texts.length}`);
  }
  return places.map((place, index) => ({ ...place, text: texts[index] }));
}

// Where each socket sits in the artwork, left to right. One per agent.
const socketPlaces: ArtPlace[] = [
  { reach: 66, side: "left", turn: "up", x: 31.1, y: 28.1 },
  { reach: 62, side: "right", turn: "up", x: 70.7, y: 26.9 },
];

// Where each key's tip sits in the artwork, left to right. One per account.
const keyPlaces: ArtPlace[] = [
  { side: "left", x: 0.9, y: 72 },
  { side: "left", x: 31.8, y: 99 },
  { side: "right", x: 74.6, y: 95.6 },
  { side: "right", x: 98.7, y: 65.2 },
];

const socketNotes = named(socketPlaces, agents, "sockets");
const keyNotes = named(keyPlaces, accounts, "key ring");
---

<section class="zone" id="e">
  <ZoneRef letter="E" />
  <h2 class="section-title">{zoneTitles.howItWorks}</h2>

  <ol class="steps">
    <li class="step">
      <div class="step-copy">
        <h3 class="step-title"><span aria-hidden="true" class="balloon">1</span>{setup.title}</h3>
        <p class="prose">{setup.body}</p>
        <CopyCommand command={setup.command} />
        <p class="note">{callouts.tools}</p>
      </div>
      <StippleFigure
        art={sockets}
        class="step-figure sockets"
        label={`Two sockets with one cable each: ${agents.join(" and ")}`}
        name="sockets"
        notes={socketNotes}
      />
    </li>

    <li class="step">
      <div class="step-copy">
        <h3 class="step-title"><span aria-hidden="true" class="balloon">2</span>{use.title}</h3>
        <p class="prose">{use.body}</p>
        <CopyCommand command={use.command} />
      </div>
      <div class="step-figure step-stack"><Stack /></div>
    </li>

    <li class="step">
      <div class="step-copy">
        <h3 class="step-title"><span aria-hidden="true" class="balloon">3</span>{login.title}</h3>
        <p class="prose">{login.body}</p>
        <CopyCommand command={login.command} />
        <p class="note">{callouts.secrets}</p>
      </div>
      <StippleFigure
        art={keyRing}
        class="step-figure keys"
        label={`A key ring with ${accounts.length} keys: ${accounts.join(", ")}`}
        name="key-ring"
        notes={keyNotes}
      />
    </li>
  </ol>
</section>
