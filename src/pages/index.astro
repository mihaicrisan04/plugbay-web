---
// plugbay.mihaicrisan.com: one drawing sheet, six zones. The zone letters on
// the frame are the anchors.
import Detail from "../components/Detail.astro";
import Hero from "../components/Hero.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Install from "../components/Install.astro";
import OneFilePerTree from "../components/OneFilePerTree.astro";
import Pain from "../components/Pain.astro";
import TitleBlock from "../components/TitleBlock.astro";
import { hero } from "../data/plugbay";
import Layout from "../layouts/Layout.astro";
---

<Layout description={hero.subhead}>
  <div class="sheet">
    <main>
      <Hero />
      <Pain />
      <OneFilePerTree />
      <Detail />
      <HowItWorks />
      <Install />
    </main>
    <TitleBlock />
  </div>
</Layout>
